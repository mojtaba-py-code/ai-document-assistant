# AI Document Assistant (docassist) - every setting, with its default.
#
# Do NOT copy this file to .env and fill in secrets by hand. Generate a development .env with
# fresh random secrets instead:
#
#     docassist init-env            # writes .env (mode 0600), refuses to overwrite
#
# and use this file as the reference for everything else. Rules:
#   * Prefix DOCASSIST_, "__" separates a section from its field (DOCASSIST_LLM__PROVIDER).
#   * Lists, and objects such as rate-limit rules, are JSON.
#   * Any secret can be read from a file instead: append _FILE to the variable name and give
#     the path, e.g. DOCASSIST_SECURITY__JWT_SIGNING_KEY_FILE=/run/secrets/jwt_signing_key
#     (Docker/Kubernetes secrets - that is how compose.yaml and deployment/kubernetes do it).
#   * Lines starting with "# DOCASSIST_" show the default; uncomment to change it.
#   * Values in <angle brackets> are placeholders and are rejected by the settings validator.
#   * Production (DOCASSIST_ENVIRONMENT=production or staging) refuses development shortcuts:
#     see deployment/compose/production.yaml and deployment/kubernetes/configmap.yaml.

# ---------------------------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------------------------
# development | test | staging | production
# DOCASSIST_ENVIRONMENT=development
# DOCASSIST_SERVICE_NAME=docassist
# DOCASSIST_PUBLIC_BASE_URL=http://localhost:8000
# Only for demos: lets production run the offline local_extractive / hashing AI components.
# DOCASSIST_ALLOW_OFFLINE_AI_IN_PRODUCTION=false

# ---------------------------------------------------------------------------------------------
# Database - three roles: API (app), worker, schema owner (migrations only)
# ---------------------------------------------------------------------------------------------
DOCASSIST_DATABASE__URL=postgresql+asyncpg://docassist_app:<password>@localhost:5432/docassist
# DOCASSIST_DATABASE__WORKER_URL=postgresql+asyncpg://docassist_worker:<password>@localhost:5432/docassist
# DOCASSIST_DATABASE__MIGRATION_URL=postgresql+asyncpg://docassist_owner:<password>@localhost:5432/docassist
# DOCASSIST_DATABASE__APP_ROLE=docassist_app
# DOCASSIST_DATABASE__WORKER_ROLE=docassist_worker
# DOCASSIST_DATABASE__POOL_SIZE=10
# DOCASSIST_DATABASE__MAX_OVERFLOW=10
# DOCASSIST_DATABASE__POOL_TIMEOUT_SECONDS=10.0
# DOCASSIST_DATABASE__STATEMENT_TIMEOUT_MS=15000
# DOCASSIST_DATABASE__LOCK_TIMEOUT_MS=5000
# DOCASSIST_DATABASE__IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# disable | prefer | require | verify-full   (production: require or verify-full)
# DOCASSIST_DATABASE__SSL=prefer
# DOCASSIST_DATABASE__ECHO=false
# DOCASSIST_DATABASE__VERIFY_ROLE_PRIVILEGES=true

# ---------------------------------------------------------------------------------------------
# Redis - cache, rate limiting, revocation (required in production)
# ---------------------------------------------------------------------------------------------
# DOCASSIST_REDIS__URL=redis://docassist:<password>@localhost:6379/0
# DOCASSIST_REDIS__KEY_PREFIX=docassist
# DOCASSIST_REDIS__SOCKET_TIMEOUT_SECONDS=1.0
# DOCASSIST_REDIS__MAX_CONNECTIONS=50

# ---------------------------------------------------------------------------------------------
# Security - the five secrets below have no default in any environment
# ---------------------------------------------------------------------------------------------
DOCASSIST_SECURITY__JWT_SIGNING_KEY=<generate: docassist init-env>
DOCASSIST_SECURITY__TOKEN_PEPPER=<generate: docassist init-env>
DOCASSIST_SECURITY__AUDIT_HMAC_KEY=<generate: docassist init-env>
# Key ring: comma-separated kid:base64(32 random bytes). New data is encrypted with the key
# named by ACTIVE_ENCRYPTION_KEY_ID; every key in the ring can still decrypt (rotation).
DOCASSIST_SECURITY__ENCRYPTION_KEYS=<generate: docassist init-env>
DOCASSIST_SECURITY__ACTIVE_ENCRYPTION_KEY_ID=<kid from ENCRYPTION_KEYS>
# JSON list of retired JWT keys still accepted for verification during a rotation.
# DOCASSIST_SECURITY__JWT_PREVIOUS_SIGNING_KEYS='[]'
# DOCASSIST_SECURITY__JWT_ISSUER=docassist
# DOCASSIST_SECURITY__JWT_AUDIENCE=docassist-api
# DOCASSIST_SECURITY__ACCESS_TOKEN_TTL_SECONDS=600
# DOCASSIST_SECURITY__REFRESH_TOKEN_TTL_SECONDS=43200
# DOCASSIST_SECURITY__SESSION_ABSOLUTE_TTL_SECONDS=604800
# DOCASSIST_SECURITY__PASSWORD_MIN_LENGTH=12
# DOCASSIST_SECURITY__PASSWORD_MAX_LENGTH=256
# DOCASSIST_SECURITY__LOCKOUT_THRESHOLD=5
# DOCASSIST_SECURITY__LOCKOUT_BASE_SECONDS=300
# DOCASSIST_SECURITY__LOCKOUT_MAX_SECONDS=3600
# DOCASSIST_SECURITY__ARGON2_TIME_COST=3
# DOCASSIST_SECURITY__ARGON2_MEMORY_KIB=65536
# DOCASSIST_SECURITY__ARGON2_PARALLELISM=2
# DOCASSIST_SECURITY__PASSWORD_RESET_TTL_SECONDS=1800
# DOCASSIST_SECURITY__MFA_ISSUER="AI Document Assistant"
# DOCASSIST_SECURITY__MFA_CHALLENGE_TTL_SECONDS=300
# DOCASSIST_SECURITY__COOKIE_SECURE=true
# Host header allow-list. Keep 127.0.0.1 for the container health check.
# DOCASSIST_SECURITY__ALLOWED_HOSTS='["localhost","127.0.0.1","testserver"]'
# DOCASSIST_SECURITY__CORS_ORIGINS='[]'
# CIDRs of reverse proxies whose X-Forwarded-* headers are trusted.
# DOCASSIST_SECURITY__TRUSTED_PROXIES='[]'
# DOCASSIST_SECURITY__EXPOSE_API_DOCS=true
# Bearer token for /metrics (without it /metrics is disabled in production).
# DOCASSIST_SECURITY__METRICS_TOKEN=<random 32-byte token>
# DOCASSIST_SECURITY__MAX_JSON_BODY_BYTES=1048576
# DOCASSIST_SECURITY__CSP_REPORT_URI=

# ---------------------------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------------------------
# DOCASSIST_UPLOAD__MAX_UPLOAD_BYTES=52428800
# DOCASSIST_UPLOAD__ALLOWED_EXTENSIONS='["pdf","docx","xlsx","csv","txt","md"]'
# DOCASSIST_UPLOAD__MAX_ZIP_ENTRIES=2000
# DOCASSIST_UPLOAD__MAX_ZIP_UNCOMPRESSED_BYTES=209715200
# DOCASSIST_UPLOAD__MAX_ZIP_RATIO=100
# DOCASSIST_UPLOAD__MAX_PDF_PAGES=2000
# none | clamav   (production: clamav, or explicitly waive with ALLOW_UNSCANNED_UPLOADS)
# DOCASSIST_UPLOAD__MALWARE_SCANNER=none
# DOCASSIST_UPLOAD__ALLOW_UNSCANNED_UPLOADS=false
# DOCASSIST_UPLOAD__CLAMAV_HOST=clamav
# DOCASSIST_UPLOAD__CLAMAV_PORT=3310
# DOCASSIST_UPLOAD__CLAMAV_TIMEOUT_SECONDS=60.0
# DOCASSIST_UPLOAD__REJECT_ACTIVE_CONTENT=true
# DOCASSIST_UPLOAD__URL_IMPORT_ENABLED=false
# DOCASSIST_UPLOAD__URL_IMPORT_ALLOWED_DOMAINS='[]'

# ---------------------------------------------------------------------------------------------
# Storage (encrypted blobs) and the parser sandbox
# ---------------------------------------------------------------------------------------------
# DOCASSIST_STORAGE__BACKEND=local
# DOCASSIST_STORAGE__ROOT=var/storage
# DOCASSIST_STORAGE__TEMP_DIR=
# DOCASSIST_PARSER__TIMEOUT_SECONDS=60.0
# DOCASSIST_PARSER__MEMORY_LIMIT_MB=1024
# DOCASSIST_PARSER__CPU_SECONDS=60
# DOCASSIST_PARSER__MAX_OUTPUT_BYTES=67108864
# DOCASSIST_PARSER__MAX_CONCURRENCY=2
# OCR needs the tesseract binary (container image built with --build-arg WITH_OCR=true).
# DOCASSIST_PARSER__OCR_ENABLED=false
# DOCASSIST_PARSER__OCR_LANGUAGES=eng
# DOCASSIST_PARSER__TESSERACT_PATH=tesseract
# DOCASSIST_CHUNKING__TARGET_TOKENS=450
# DOCASSIST_CHUNKING__MAX_TOKENS=800
# DOCASSIST_CHUNKING__OVERLAP_TOKENS=60

# ---------------------------------------------------------------------------------------------
# Embeddings - "hashing" is offline (dev/test); DIMENSIONS must match the migrated schema
# ---------------------------------------------------------------------------------------------
# hashing | openai_compatible
# DOCASSIST_EMBEDDING__PROVIDER=hashing
# DOCASSIST_EMBEDDING__MODEL=hashing-v1
# DOCASSIST_EMBEDDING__DIMENSIONS=1024
# DOCASSIST_EMBEDDING__BASE_URL=https://embeddings.example.com/v1
# DOCASSIST_EMBEDDING__API_KEY=<embedding provider key>
# true = text leaves your infrastructure: classification ceiling applies.
# DOCASSIST_EMBEDDING__IS_EXTERNAL=true
# DOCASSIST_EMBEDDING__BATCH_SIZE=64
# DOCASSIST_EMBEDDING__TIMEOUT_SECONDS=30.0
# DOCASSIST_EMBEDDING__MAX_RETRIES=3
# DOCASSIST_EMBEDDING__SEND_DIMENSIONS=true

# ---------------------------------------------------------------------------------------------
# LLM - "local_extractive" is offline (dev/test)
# ---------------------------------------------------------------------------------------------
# anthropic | openai_compatible | local_extractive
# DOCASSIST_LLM__PROVIDER=local_extractive
# DOCASSIST_LLM__ANTHROPIC_API_KEY=<anthropic api key>
# DOCASSIST_LLM__ANTHROPIC_BASE_URL=
# DOCASSIST_LLM__MAIN_MODEL=claude-opus-5-5
# DOCASSIST_LLM__FAST_MODEL=claude-haiku-4-5
# low | medium | high | xhigh | max
# DOCASSIST_LLM__MAIN_EFFORT=medium
# DOCASSIST_LLM__ENABLE_SERVER_FALLBACKS=true
# Provider for text above EXTERNAL_MAX_CLASSIFICATION: none | openai_compatible | local_extractive
# DOCASSIST_LLM__LOCAL_PROVIDER=local_extractive
# DOCASSIST_LLM__LOCAL_BASE_URL=http://ollama:11434/v1
# DOCASSIST_LLM__LOCAL_MODEL=local-model
# DOCASSIST_LLM__LOCAL_API_KEY=
# DOCASSIST_LLM__REQUEST_TIMEOUT_SECONDS=120.0
# DOCASSIST_LLM__MAX_RETRIES=2
# DOCASSIST_LLM__MAX_OUTPUT_TOKENS=8000
# DOCASSIST_LLM__MAX_CONTEXT_TOKENS=12000
# DOCASSIST_LLM__MAX_QUESTION_CHARS=2000
# PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED - highest classification sent to external AI.
# DOCASSIST_LLM__EXTERNAL_MAX_CLASSIFICATION=CONFIDENTIAL
# DOCASSIST_LLM__PSEUDONYMIZE_PII_FOR_EXTERNAL=true
# DOCASSIST_LLM__MONTHLY_TOKEN_BUDGET_PER_ORG=5000000
# DOCASSIST_LLM__CIRCUIT_FAILURE_THRESHOLD=5
# DOCASSIST_LLM__CIRCUIT_RESET_SECONDS=30.0
# DOCASSIST_LLM__ANSWER_CACHE_TTL_SECONDS=900
# DOCASSIST_LLM__AGENT_MAX_ITERATIONS=5
# DOCASSIST_LLM__AGENT_MAX_TOOL_CALLS=8
# DOCASSIST_LLM__TOOL_TIMEOUT_SECONDS=15.0
# USD per million tokens, per model (usage reports and budgets).
# DOCASSIST_LLM__PRICING='{"claude-opus-5-5":{"input_per_mtok":4.0,"output_per_mtok":20.0},"claude-sonnet-5-5":{"input_per_mtok":2.0,"output_per_mtok":10.0},"claude-haiku-4-5":{"input_per_mtok":1.0,"output_per_mtok":5.0}}'

# ---------------------------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------------------------
# pgvector | qdrant
# DOCASSIST_RETRIEVAL__BACKEND=pgvector
# DOCASSIST_RETRIEVAL__QDRANT_URL=http://qdrant:6333
# DOCASSIST_RETRIEVAL__QDRANT_API_KEY=<qdrant api key>
# DOCASSIST_RETRIEVAL__QDRANT_COLLECTION=docassist_chunks
# DOCASSIST_RETRIEVAL__TOP_K=8
# DOCASSIST_RETRIEVAL__CANDIDATE_POOL=40
# DOCASSIST_RETRIEVAL__RRF_K=60
# DOCASSIST_RETRIEVAL__MMR_LAMBDA=0.7
# DOCASSIST_RETRIEVAL__MIN_RELEVANCE=0.05
# DOCASSIST_RETRIEVAL__INJECTION_EXCLUDE_THRESHOLD=0.8
# DOCASSIST_RETRIEVAL__INJECTION_WARN_THRESHOLD=0.4
# DOCASSIST_RETRIEVAL__HNSW_EF_SEARCH=100
# DOCASSIST_RETRIEVAL__MAX_QUERY_CHARS=1000

# ---------------------------------------------------------------------------------------------
# Rate limits - {"requests": N, "per_seconds": S} (GCRA, burst = requests)
# ---------------------------------------------------------------------------------------------
# DOCASSIST_RATE_LIMIT__ENABLED=true
# DOCASSIST_RATE_LIMIT__LOGIN_PER_IP='{"requests":20,"per_seconds":60}'
# DOCASSIST_RATE_LIMIT__LOGIN_PER_ACCOUNT='{"requests":5,"per_seconds":60}'
# DOCASSIST_RATE_LIMIT__REFRESH_PER_SESSION='{"requests":30,"per_seconds":60}'
# DOCASSIST_RATE_LIMIT__PASSWORD_RESET_PER_IP='{"requests":5,"per_seconds":3600}'
# DOCASSIST_RATE_LIMIT__API_PER_USER='{"requests":600,"per_seconds":60}'
# DOCASSIST_RATE_LIMIT__UPLOAD_PER_USER='{"requests":60,"per_seconds":3600}'
# DOCASSIST_RATE_LIMIT__SEARCH_PER_USER='{"requests":120,"per_seconds":60}'
# DOCASSIST_RATE_LIMIT__LLM_PER_USER='{"requests":20,"per_seconds":60}'
# DOCASSIST_RATE_LIMIT__LLM_PER_ORG='{"requests":600,"per_seconds":60}'
# DOCASSIST_RATE_LIMIT__EXPORT_PER_USER='{"requests":10,"per_seconds":3600}'
# DOCASSIST_RATE_LIMIT__TOOL_CALLS_PER_USER='{"requests":60,"per_seconds":60}'
# DOCASSIST_RATE_LIMIT__USER_CREATE_PER_ADMIN='{"requests":120,"per_seconds":3600}'

# ---------------------------------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------------------------------
# DOCASSIST_RETENTION__CONVERSATION_DAYS=90
# DOCASSIST_RETENTION__AUDIT_DAYS=2555
# DOCASSIST_RETENTION__EXPORT_TTL_HOURS=24
# DOCASSIST_RETENTION__JOB_DAYS=30
# DOCASSIST_RETENTION__LLM_USAGE_DAYS=400
# DOCASSIST_RETENTION__DELETED_DOCUMENT_PURGE_DAYS=30

# ---------------------------------------------------------------------------------------------
# Outbound HTTP (SSRF policy for every server-side request)
# ---------------------------------------------------------------------------------------------
# DOCASSIST_OUTBOUND__ALLOWED_HOSTS='["api.anthropic.com"]'
# Host names allowed to resolve to private addresses (local model servers, Qdrant).
# DOCASSIST_OUTBOUND__PRIVATE_NETWORK_ALLOWLIST='[]'
# DOCASSIST_OUTBOUND__MAX_RESPONSE_BYTES=52428800
# DOCASSIST_OUTBOUND__TIMEOUT_SECONDS=30.0
# DOCASSIST_OUTBOUND__MAX_REDIRECTS=3

# ---------------------------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------------------------
# DOCASSIST_WORKER__CONCURRENCY=4
# DOCASSIST_WORKER__POLL_INTERVAL_SECONDS=1.0
# DOCASSIST_WORKER__LEASE_SECONDS=120
# DOCASSIST_WORKER__MAX_ATTEMPTS=5
# DOCASSIST_WORKER__BACKOFF_BASE_SECONDS=5.0
# DOCASSIST_WORKER__BACKOFF_MAX_SECONDS=900.0
# DOCASSIST_WORKER__SHUTDOWN_GRACE_SECONDS=30.0
# DOCASSIST_WORKER__MAINTENANCE_INTERVAL_SECONDS=30.0

# ---------------------------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR   (DEBUG is refused in production)
# DOCASSIST_OBSERVABILITY__LOG_LEVEL=INFO
# json | console
# DOCASSIST_OBSERVABILITY__LOG_FORMAT=json
# DOCASSIST_OBSERVABILITY__METRICS_ENABLED=true
# How search/question text appears in audit details: redacted | hash | none
# DOCASSIST_OBSERVABILITY__AUDIT_QUERY_TEXT=redacted
